{
  "folders": [
    {
      "name": "Artículos",
      "path": "posts"
    },
    {
      "name": "Editorial",
      "path": "editorial"
    }
  ],
  "settings": {
    "git.openRepositoryInParentFolders": "always",
    "files.exclude": {
      "**/*_cache": true,
      "**/*_files": true,
      "**/.DS_Store": true
    },
    "search.exclude": {
      "**/*_cache/**": true,
      "**/*_files/**": true
    },
    "files.associations": {
      "*.qmd": "quarto"
    }
  }
}
